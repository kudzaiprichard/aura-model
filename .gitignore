# DataSpell IDE
.idea/
.dataspell/

# AI Model files
models/
results/
lookup_tables/
*.h5
*.pkl
*.pth
*.pt
*.onnx
*.pb
*.tflite

# Datasets
datasets/
data/
*.csv

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python caches
__pycache__/
*.pyc

# Streamlit dashboard runtime data (drift logs, etc.)
dashboard_data/

# Streamlit app config
.streamlit/

# Inference fixtures are tracked even though _datasets/ and *.csv are not.
!inference/tests/fixtures/
!inference/tests/fixtures/*.json

# Investigation datasets are tracked (override *.csv exclusion)
!investigation/_datasets/
!investigation/_datasets/*.csv
